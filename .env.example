# Postgres（docker-compose.yml 的 postgres service 設定，不設定就維持純記憶體模式，見 README）
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# server/services/db.ts 讀這個變數；留空或整行刪除 = isDbEnabled() 回傳 false，
# 全站退回目前的純記憶體模式（重啟全歸零），不會因為沒接 DB 就壞掉。
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio

# ── 正式環境上線前請務必調整下列變數 ──
# 見 openspec/changes/harden-postgres-for-production/
# - POSTGRES_PASSWORD（上面）：換成正式密碼，不要用這份範例值
# - SEED_DEMO_DATA=false：正式環境不要自動產生測試帳號/NPC假會員（本機開發留 true 即可）
# - SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD：換成正式管理帳號，不要用預設的 admin@example.com/123456
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=123456
