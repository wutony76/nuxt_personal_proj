# production 環境變數範本。setup-vm.sh 會複製到 /srv/portfolio/shared/.env（權限 600），
# 請在 VM 上填入實際值。這個檔案本身不要放真實密碼。

# 資料庫：Cloud SQL Auth Proxy 在 VM 本機 127.0.0.1:5432 提供連線
# 密碼含特殊字元時需要 URL encode（例如 @ → %40）
DATABASE_URL=postgres://portfolio:CHANGE_ME@127.0.0.1:5432/portfolio

# 種子管理員帳號（production 沒設定密碼會拒絕啟動）
# ⚠️ 只在資料庫還沒有任何會員的第一次啟動時寫入，之後修改這裡不會改到既有密碼
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# hfyy@cc.cc 的密碼
SEED_OWNER_PASSWORD=

# 是否建立測試與 NPC 帳號（test02～test04 等）。作品集 Demo 需要 test04 唯讀帳號，保持 true
SEED_DEMO_DATA=true
